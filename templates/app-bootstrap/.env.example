# Values are parsed as literal text. Do not use shell expressions or quote syntax.
# List only commands provided by the application or its documented prerequisites.
APP_REQUIRED_COMMANDS=git
# Paths are relative to the repository root and must not contain "..".
APP_REQUIRED_FILES=.env
# Optional. Only a localhost or 127.0.0.1 HTTP(S) endpoint is checked.
APP_HEALTHCHECK_URL=
